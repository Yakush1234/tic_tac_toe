# Optional local backend settings. Copy to .env to customize.
BACKEND_APP_TITLE="Tic-Tac-Toe"
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_MAX_GAMES=10000
BACKEND_BOT_SEARCH_BUDGET_MS=200
BACKEND_LOG_LEVEL=INFO
BACKEND_LOG_FORMAT="%(asctime)s %(levelname)s %(name)s %(message)s"

# Published frontend port for Docker Compose.
FRONTEND_PORT=8080
